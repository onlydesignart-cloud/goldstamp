{
  "name": "goldstamp-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Gold Stamp - Multi-tenant SaaS Platform for Digital Loyalty & Stamp Programs",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:api": "npm run dev --workspace=backend",
    "dev:web": "npm run dev --workspace=frontend",
    "dev:app": "npm run start --workspace=customer-app",
    "build": "npm run build --workspaces",
    "db:generate": "npm run db:generate --workspace=backend",
    "db:push": "npm run db:push --workspace=backend",
    "db:seed": "npm run db:seed --workspace=backend",
    "test": "npm run test --workspaces"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
