{
  "name": "@goldstamp/api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node18 --outfile=dist/server.js --alias:@goldstamp/validation=../packages/validation/src/index.ts --alias:@goldstamp/config=../packages/config/src/index.ts --alias:@goldstamp/types=../packages/types/src/index.ts --external:@prisma/client --external:bcrypt --external:express --external:cors --external:helmet --external:morgan --external:jsonwebtoken --external:qrcode --external:zod",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/prisma/seed.ts",
    "test": "vitest run",
    "test:e2e": "tsx verify-e2e.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@goldstamp/config": "*",
    "@goldstamp/types": "*",
    "@goldstamp/validation": "*",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.19.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/qrcode": "^1.5.5",
    "prisma": "^6.4.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
