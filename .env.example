# Database (MySQL / phpMyAdmin)
DATABASE_URL="mysql://root:@localhost:3306/digitalstamp"

# Server Port
PORT=4000
NODE_ENV=development

# JWT Secrets
JWT_SECRET="super-secure-jwt-secret-key-stampify-2026-production-grade"
JWT_REFRESH_SECRET="super-secure-refresh-jwt-secret-key-stampify-2026"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# QR Code Configuration
QR_TOKEN_SECRET="super-secure-qr-hmac-token-secret-stampify-2026"
QR_EXPIRY_SECONDS=60

# Redis / Queue
REDIS_URL="redis://localhost:6379"

# Storage (Cloudflare R2 / AWS S3 abstraction)
S3_ENDPOINT=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_BUCKET="stampify-assets"

# Payments (Razorpay abstraction)
RAZORPAY_KEY_ID="rzp_test_mock_stampify_key"
RAZORPAY_KEY_SECRET="rzp_test_mock_stampify_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_mock_webhook_secret"

# Notifications
WHATSAPP_API_KEY=""
EMAIL_API_KEY=""

# URLs
NEXT_PUBLIC_API_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
